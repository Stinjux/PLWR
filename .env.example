# ---------------------------------------------------------------
# PLWR – variables d'environnement (copier en .env puis remplir)
# Ne jamais versionner le fichier .env : il contient des secrets.
#
# Sur Railway, seules ces variables sont à définir (onglet Variables) :
#   PORT=3000 (même port que le domaine généré), APP_SECRET, ANTHROPIC_API_KEY,
#   VISION_PROVIDER, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT,
#   ALLOW_SIGNUP, DEFAULT_TIMEZONE
# DATA_DIR, APP_URL et COOKIE_SECURE sont
# déduits de RAILWAY_VOLUME_MOUNT_PATH et RAILWAY_PUBLIC_DOMAIN.
# ---------------------------------------------------------------

# Serveur
PORT=3000
# URL publique (HTTPS en production : obligatoire pour les notifications et l'installation sur iPhone)
APP_URL=http://localhost:3000
# Secret de signature des liens « Reporter » des notifications (obligatoire en production)
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=remplacer-par-une-longue-valeur-aleatoire
# Dossier des données (base SQLite + images temporaires). Sur Railway : volume monté sur /data (détecté)
# En local seulement. Sur Railway, ne PAS définir DATA_DIR : le volume est utilisé automatiquement.
DATA_DIR=./data
# Cookies « Secure » (true derrière HTTPS ; automatique si NODE_ENV=production)
COOKIE_SECURE=false
# Permettre la création d'autres comptes après le premier (application personnelle : false)
ALLOW_SIGNUP=false
DEFAULT_TIMEZONE=America/Toronto

# ---------- Lecture d'images (reçus, captures bancaires) ----------
# anthropic (par défaut, recommandé) | local (OCR Tesseract hors ligne, moins précis) | mock-error (simule une panne)
VISION_PROVIDER=anthropic
# Clé API Anthropic : https://console.anthropic.com → API Keys. Reste côté serveur.
ANTHROPIC_API_KEY=
# Modèle utilisé pour lire les images
ANTHROPIC_VISION_MODEL=claude-opus-5-5
# Budget de pixels envoyé pour une image (en mégapixels, 0.3 à 1.15). Moins = moins de jetons.
VISION_MAX_MEGAPIXELS=0.9

# ---------- Économie de jetons (assistant et objectifs écrits) ----------
# Les demandes simples sont traitées par des règles locales, sans appel. Claude n'est appelé que pour le reste.
# Modèle texte : claude-opus-5-5 (par défaut, le plus fiable) ou claude-haiku-5-5 (environ 40 fois moins cher par jeton)
ANTHROPIC_TEXT_MODEL=claude-opus-5-5
# Appels maximum par personne et par jour (0 = sans limite). Au-delà : réponses des règles locales.
AI_DAILY_CALLS=30
VISION_TIMEOUT_MS=60000
MAX_UPLOAD_MB=12
# Masquer automatiquement les numéros de carte (OCR local) AVANT l'envoi au fournisseur
REDACT_CARD_NUMBERS=true
# Supprimer l'image dès que toutes ses lignes sont confirmées ou retirées
DELETE_IMAGES_AFTER_VALIDATION=true
# Purge de sécurité des images jamais validées (heures)
IMAGE_MAX_RETENTION_HOURS=72

# ---------- Notifications push (Web Push / VAPID) ----------
# Générer une paire de clés : npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact exigé par les services push (courriel ou URL)
VAPID_SUBJECT=mailto:moi@exemple.ca
# Fréquence de vérification des rappels (ms)
SCHEDULER_INTERVAL_MS=30000

# ---------- Google Agenda (facultatif) ----------
# Sans ces variables, chaque personne importe ses propres identifiants dans Réglages → Google Agenda (guide pas à pas).
# Avec elles, tout le monde utilise ce client OAuth et n'a qu'à autoriser PLWR.
# URI de redirection à déclarer chez Google : <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Minutes entre deux synchronisations automatiques
GOOGLE_SYNC_MINUTES=5

# ---------- Outlook / Microsoft 365 (facultatif) ----------
# Sans ces variables, chaque personne importe ses propres identifiants dans Réglages → Outlook (guide pas à pas).
# Application Microsoft Entra, plateforme Web, URI de redirection : <APP_URL>/api/outlook/callback
# Autorisations déléguées Microsoft Graph : Calendars.ReadWrite, offline_access, User.Read
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# common (comptes pro et personnels), consumers (personnels seulement) ou l'ID de l'annuaire
OUTLOOK_TENANT=common
OUTLOOK_SYNC_MINUTES=5

# ---------- Comptes ----------
# Nombre maximal de comptes (inscriptions et invitations comprises)
MAX_USERS=6
