{
  "name": "plwr",
  "version": "0.1.0",
  "private": true,
  "description": "Application personnelle : agenda, objectifs et budget (fr-CA, CAD, America/Toronto)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.ts & vite --config web/vite.config.ts",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "seed": "node --env-file-if-exists=.env server/scripts/seed.ts",
    "vapid": "node server/scripts/vapid.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "DB_FILE=:memory: node --test server/tests/*.test.ts",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "hono": "^4.13.17",
    "luxon": "^3.7.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  }
}
